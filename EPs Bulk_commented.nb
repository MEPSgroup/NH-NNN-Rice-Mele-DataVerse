}, Open  ]],

Cell[CellGroupData[{

Cell["9. Final figure \[LongDash] GraphicsGrid of all four panels", "Section",ExpressionUUID->"4f64caf0-4e3a-4fcb-872b-5813f4d5b0b7"],

Cell["\<\
Assemble the four panels into a 2x2 grid: top row (a,b) has t=1/2;
bottom row (c,d) has t=3/2. Left column (a,c) has gamma=1.4; right column \
(b,d) has gamma=1.6.
ImageSize->Full stretches the grid to fill the notebook window.\
\>", "Text",ExpressionUUID->"271277b5-6e7f-42e3-8e12-8da7dd7b4a84"],

Cell[CellGroupData[{

Cell["\<\
(*Fig. 2: assemble panels in a 2x2 GraphicsGrid.
  Row 1: panels A (t=1/2, gamma=1.4) and B (t=1/2, gamma=1.6)
  Row 2: panels C (t=3/2, gamma=1.4) and D (t=3/2, gamma=1.6) *)
GraphicsGrid[
  {{panelA, panelB},
   {panelC, panelD}},
  ImageSize -> Full
]\
\>", "Input",
 CellLabel->
  "In[618]:=",ExpressionUUID->"8598fb50-3380-46b9-b238-53c5b6fbb5c0"],

