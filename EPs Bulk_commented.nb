Notebook[{

Cell[CellGroupData[{
Cell["1. Initialisation", "Section",ExpressionUUID->"8bb56306-7096-4a5d-a186-0727b7e363ff"],

Cell["\<\
Set publication-quality defaults for ComplexListPlot (font, axes colour).
All subsequent ComplexListPlot calls inherit these options.\
\>", "Text",ExpressionUUID->"9201e7c3-585d-42cc-8bc9-3ffaf8352cef"],

Cell["\<\
(*Set default ComplexListPlot options: Latin Modern Roman font at 14 pt,
  black axes with black tick labels \[LongDash] publication style.*)
SetOptions[ComplexListPlot,
  BaseStyle  -> {FontFamily -> \"Latin Modern Roman\", FontSize -> 14},
  AxesStyle  -> Directive[Black, FontColor -> Black]
];\
\>", "Input",
 CellLabel->
  "In[521]:=",ExpressionUUID->"d5128df1-8943-4e7b-ab68-50cc339fc338"]
}, Open  ]],

Cell[CellGroupData[{

Cell["2. Non-Hermitian Bloch Hamiltonian", "Section",ExpressionUUID->"21c9a641-0317-4692-8770-bcd740fd5994"],

Cell["\<\
Define the d-vector and Pauli-matrix basis (arXiv:2606.24705, Eq.(2),
https://arxiv.org/abs/2606.24705).
H_RM(kappa) = d . sigma, where
  d = {epsilon_p - 2m cos(kappa), -t - t' cos(kappa), -t' sin(kappa), \
epsilon_m + i*gamma}
  sigma = {I_2, sigma_1, sigma_2, sigma_3}
The complex conjugation helper CC[ ] is used when checking EP conditions.\
\>", "Text",ExpressionUUID->"3b968793-5ba9-4324-94fc-31e485008a96"],

Cell["\<\
(*Complex conjugation: replace every Complex[a,b] by Complex[a,-b].*)
CC[arg_] := arg /. Complex[a_, b_] :> Complex[a, -b];

(*d-vector components (arXiv:2606.24705, Eq.(2)): d = {d0, d1, d2, d3}.
  d0 = epsilon_p - 2m*cos(kappa)  [NNN identity term]
  d1 = -t - t'*cos(kappa)         [real off-diagonal]
  d2 = -t'*sin(kappa)             [imaginary off-diagonal]
  d3 = epsilon_m + I*gamma        [non-Hermitian on-site imbalance] *)
d = {\[Epsilon]p - 2 m Cos[\[Kappa]],
     -t - tp Cos[\[Kappa]],
     -tp Sin[\[Kappa]],
     \[Epsilon]m + I \[Gamma]};

(*Pauli matrix basis: sigma = {I_2, sigma_x, sigma_y, sigma_z}.*)
\[Sigma] = {IdentityMatrix[2],
            {{0, 1}, {1, 0}},
            {{0, -I}, {I, 0}},
            {{1, 0}, {0, -1}}};\
\>", "Input",
 CellLabel->
  "In[523]:=",ExpressionUUID->"71f8a9f1-b567-4d7a-ac87-4773aa59492e"]
}, Open  ]],

Cell[CellGroupData[{

Cell["3. Exceptional-point conditions", "Section",ExpressionUUID->"76a51932-0fb4-4810-93c8-54bd66d814bf"],

Cell["\<\
EPs occur where two eigenvalues AND two eigenvectors coalesce.
For H = d.sigma, two simultaneous conditions must hold (arXiv:2606.24705, Sec. II, Eqs.(5a)-(5b),
https://arxiv.org/abs/2606.24705):
  (i)  Re[d].Re[d] - Im[d].Im[d] = 0
  (ii) Re[d].Im[d] = 0
For epsilon_m = 0 condition (ii) reduces to gamma*epsilon_m = 0, which is
automatic; the EP threshold is then gamma_c(kappa) = Sqrt[t^2+t'^2+2tt'cos(kappa)]
(arXiv:2606.24705, Eq.(6)).\
\>", "Text",ExpressionUUID->"d1413c63-d4dd-4d7a-a8cf-94e4ee1b9df4"],

Cell["\<\
(*EP condition (i): Re[d].Re[d] - Im[d].Im[d] must vanish (arXiv:2606.24705, Eq.(5a)).*)
epCondI = FullSimplify[
  ComplexExpand[Re[d] . Re[d] - Im[d] . Im[d]]
];

(*EP condition (ii): Re[d].Im[d] must vanish.
  With epsilon_m -> 0 this becomes gamma*epsilon_m = 0, trivially \
satisfied.*)
epCondII = FullSimplify[Re[d] . Im[d],
  Assumptions -> {\[Epsilon]m \[Element] Reals,
                   \[Gamma]   \[Element] Reals}
];

(*Bulk dispersion E_pm(kappa) from Eigensystem of d.sigma (arXiv:2606.24705, Eq.(4)):
  E_pm = epsilon_p - 2m*cos(kappa) +/- \
Sqrt[t^2+t'^2+2tt'cos(kappa)-(gamma-i*epsilon_m)^2] *)
{en, vec} = Eigensystem[d . \[Sigma]] // FullSimplify;

(*Special case epsilon_m = 0: dispersion becomes real-valued under the EP \
threshold.*)
enA = en /. \[Epsilon]m -> 0;\
\>", "Input",
 CellLabel->
  "In[531]:=",ExpressionUUID->"f4e05d94-5837-48bc-be0f-7cb63b6c16c1"]
}, Open  ]],

Cell[CellGroupData[{

Cell["4. EP marker and helper functions", "Section",ExpressionUUID->"b33688d0-368d-4acd-bfa5-c61852080174"],

Cell["\<\
EPmarker draws a coloured point with a black circle outline at the EP
position in the complex-energy plane. The circle radius is given in scaled
(plot-fraction) coordinates so it stays the same size regardless of \
PlotRange.
cosKEP, EPreal, EPexists compute the EP momentum, the corresponding real-energy
position on the Im[E]=0 axis, and whether the EP exists (|cos(kappa_EP)| <= \
1).\
\>", "Text",ExpressionUUID->"d3cd3366-4a87-4527-9725-4cdff9afd500"],

Cell["\<\
(*EPmarker: coloured Point at pos with a black Circle of radius 0.015
  in scaled coordinates, and AbsoluteThickness 1.2 for the circle stroke.
  The star version (Inset[Style[FivePointedStar,...]]) is commented out \
below;
  switch the active definition to use stars instead of circles.*)
EPmarker[pos_, color_] := {color, PointSize[0.025], Point[pos], Black,
   AbsoluteThickness[1.2], Circle[pos, Scaled[{0.015, 0.015}]]};

(*Alternative star marker (centred on pos via {Center,Center}):*)
(*EPmarker[pos_, color_] := Inset[
     Style[\"\[FivePointedStar]\", color, FontSize -> 18, FontWeight -> \
Bold],
     pos, {Center, Center}];*)

(*Fix tp = 1 throughout; epsPlus is the reference on-site energy.*)
epsPlus = 1;

(*cosKEP: cos(kappa_EP) from the EP threshold condition (arXiv:2606.24705, Eq.(6))
  gamma_c^2 = t^2+tp^2+2tt'cos(kappa).
  Solved for cos(kappa) with tp = 1.*)
cosKEP[t_, gamma_] := (gamma^2 - t^2 - tp^2)/(2 t tp) /. tp -> 1;

(*EPreal: Re[E] at the EP, equals epsPlus - 2m*cos(kappa_EP) (Im[E]=0 at EP).*)
EPreal[m_, t_, gamma_] := (epsPlus - 2 m cosKEP[t, gamma]) /. tp -> 1;

(*EPexists: True when |cos(kappa_EP)| <= 1, i.e. the EP lies in the Brillouin \
zone.*)
EPexists[t_, gamma_] := (Abs[cosKEP[t, gamma]] <= 1) /. tp -> 1;\
\>", "Input",
 CellLabel->
  "In[542]:=",ExpressionUUID->"a86e3141-2370-4cfc-8702-e15e2d94eb40"]
}, Open  ]],

Cell[CellGroupData[{

Cell["5. Panel A \[LongDash] complex spectrum, t=1/2, gamma=1.4", "Section",ExpressionUUID->"84c19ef8-6917-4e88-8acf-8bf63a92a523"],

Cell["\<\
Panel (a) of Fig. 2: ComplexListPlot of E_pm(kappa) in the complex plane
for t=1/2 < t'=1 (|t-t'|=0.5 < gamma_c < t+t'=1.5) and gamma=1.4.
Three values of the staggered hopping m are shown: m=0, m=t', m=2t'.
Green circle markers indicate EP positions computed by EPmarker.\
\>", "Text",ExpressionUUID->"989f3f18-cd2b-40e0-a7c6-3e7fa45cb6ce"],

Cell["\<\
(*Parameters for panel (a): t=1/2, tp=1, gamma=1.4, epsilon_p=1, nn=500 kappa \
points.*)
var = {t -> 1/2, tp -> 1, \[Gamma] -> 14/10, \[Epsilon]p -> 1, nn -> 500};

(*Sample E_pm(kappa) over the Brillouin zone for m = 0, 1, 2 (in units of \
tp=1).
  E_+ and E_- give six coloured series for the ComplexListPlot.*)
enRPBCBlochPm0PanA = Table[(\[Epsilon]p - 2 m Cos[\[Kappa]] -
    Sqrt[t^2 + tp^2 - \[Gamma]^2 + 2 t tp Cos[\[Kappa]]]) /. var /. m -> 0,
  {\[Kappa], -\[Pi], \[Pi], 2\[Pi]/(nn /. var)}];
enRPBCBlochNm0PanA = Table[(\[Epsilon]p - 2 m Cos[\[Kappa]] +
    Sqrt[t^2 + tp^2 - \[Gamma]^2 + 2 t tp Cos[\[Kappa]]]) /. var /. m -> 0,
  {\[Kappa], -\[Pi], \[Pi], 2\[Pi]/(nn /. var)}];
enRPBCBlochPm1PanA = Table[(\[Epsilon]p - 2 m Cos[\[Kappa]] -
    Sqrt[t^2 + tp^2 - \[Gamma]^2 + 2 t tp Cos[\[Kappa]]]) /. var /. m -> 1,
  {\[Kappa], -\[Pi], \[Pi], 2\[Pi]/(nn /. var)}];
enRPBCBlochNm1PanA = Table[(\[Epsilon]p - 2 m Cos[\[Kappa]] +
    Sqrt[t^2 + tp^2 - \[Gamma]^2 + 2 t tp Cos[\[Kappa]]]) /. var /. m -> 1,
  {\[Kappa], -\[Pi], \[Pi], 2\[Pi]/(nn /. var)}];
enRPBCBlochPm2PanA = Table[(\[Epsilon]p - 2 m Cos[\[Kappa]] -
    Sqrt[t^2 + tp^2 - \[Gamma]^2 + 2 t tp Cos[\[Kappa]]]) /. var /. m -> 2,
  {\[Kappa], -\[Pi], \[Pi], 2\[Pi]/(nn /. var)}];
enRPBCBlochNm2PanA = Table[(\[Epsilon]p - 2 m Cos[\[Kappa]] +
    Sqrt[t^2 + tp^2 - \[Gamma]^2 + 2 t tp Cos[\[Kappa]]]) /. var /. m -> 2,
  {\[Kappa], -\[Pi], \[Pi], 2\[Pi]/(nn /. var)}];

(*Compute EP positions in the complex plane; EPmarker returns {} when EP does \
not exist.*)
panelAmarkers = With[{tv = t /. var, gv = \[Gamma] /. var},
  Graphics[{
    If[EPexists[tv, gv], EPmarker[{EPreal[0, tv, gv], 0}, Green], {}],
    If[EPexists[tv, gv], EPmarker[{EPreal[1, tv, gv], 0}, Green], {}],
    If[EPexists[tv, gv], EPmarker[{EPreal[2, tv, gv], 0}, Green], {}]
  }]];

(*Fig. 2(a): ComplexListPlot of the six energy series; overlay EP markers and \
panel label.*)
panelA = Show[
  ComplexListPlot[
    {enRPBCBlochPm0PanA, enRPBCBlochNm0PanA,
     enRPBCBlochPm1PanA, enRPBCBlochNm1PanA,
     enRPBCBlochPm2PanA, enRPBCBlochNm2PanA},
    Frame -> False, AspectRatio -> 1,
    PlotStyle -> {{Red,    PointSize[0.0125]}, {Red,    PointSize[0.0125]},
                  {Blue,   PointSize[0.0125]}, {Blue,   PointSize[0.0125]},
                  {Orange, PointSize[0.0125]}, {Orange, PointSize[0.0125]}},
    PlotLegends -> Placed[
      {\"m=0\", None, \"m=t'\", None, \"m=2t'\", None},
      {0.1, 0.15}],
    AxesLabel -> {\"Re[\[ScriptCapitalE]]/t'\", \
\"Im[\[ScriptCapitalE]]/t'\"},
    AspectRatio -> Automatic, PlotRange -> {Automatic},
    Background -> None],
  panelAmarkers,
  Graphics@Text[Style[\"(a)\", Large], {-3, 1.3}]
];\
\>", "Input",
 CellLabel->
  "In[559]:=",ExpressionUUID->"cbcb7bf7-5c0e-4874-82d2-c5c34e70ba79"]
}, Open  ]],

Cell[CellGroupData[{

Cell["6. Panel B \[LongDash] complex spectrum, t=1/2, gamma=1.6", "Section",ExpressionUUID->"aa03a058-6d41-4a52-99fd-d9e63ff5cdac"],

Cell["\<\
Panel (b) of Fig. 2: same hopping t=1/2 as (a) but gamma=1.6 > t+t'=1.5.
Above the upper EP threshold: all eigenvalues have non-zero imaginary part.\
\>", "Text",ExpressionUUID->"85987883-0557-4c64-9087-69441ae7cbeb"],

Cell["\<\
(*Parameters for panel (b): gamma raised to 1.6 \[LongDash] above the EP \
threshold gamma_c(0)=t+t'.*)
var = {t -> 1/2, tp -> 1, \[Gamma] -> 16/10, \[Epsilon]p -> 1, nn -> 500};

(*Sample E_pm for m = 0, 1, 2 as in panel (a).*)
enRPBCBlochPm0PanB = Table[(\[Epsilon]p - 2 m Cos[\[Kappa]] -
    Sqrt[t^2 + tp^2 - \[Gamma]^2 + 2 t tp Cos[\[Kappa]]]) /. var /. m -> 0,
  {\[Kappa], -\[Pi], \[Pi], 2\[Pi]/(nn /. var)}];
enRPBCBlochNm0PanB = Table[(\[Epsilon]p - 2 m Cos[\[Kappa]] +
    Sqrt[t^2 + tp^2 - \[Gamma]^2 + 2 t tp Cos[\[Kappa]]]) /. var /. m -> 0,
  {\[Kappa], -\[Pi], \[Pi], 2\[Pi]/(nn /. var)}];
enRPBCBlochPm1PanB = Table[(\[Epsilon]p - 2 m Cos[\[Kappa]] -
    Sqrt[t^2 + tp^2 - \[Gamma]^2 + 2 t tp Cos[\[Kappa]]]) /. var /. m -> 1,
  {\[Kappa], -\[Pi], \[Pi], 2\[Pi]/(nn /. var)}];
enRPBCBlochNm1PanB = Table[(\[Epsilon]p - 2 m Cos[\[Kappa]] +
    Sqrt[t^2 + tp^2 - \[Gamma]^2 + 2 t tp Cos[\[Kappa]]]) /. var /. m -> 1,
  {\[Kappa], -\[Pi], \[Pi], 2\[Pi]/(nn /. var)}];
enRPBCBlochPm2PanB = Table[(\[Epsilon]p - 2 m Cos[\[Kappa]] -
    Sqrt[t^2 + tp^2 - \[Gamma]^2 + 2 t tp Cos[\[Kappa]]]) /. var /. m -> 2,
  {\[Kappa], -\[Pi], \[Pi], 2\[Pi]/(nn /. var)}];
enRPBCBlochNm2PanB = Table[(\[Epsilon]p - 2 m Cos[\[Kappa]] +
    Sqrt[t^2 + tp^2 - \[Gamma]^2 + 2 t tp Cos[\[Kappa]]]) /. var /. m -> 2,
  {\[Kappa], -\[Pi], \[Pi], 2\[Pi]/(nn /. var)}];

panelAmarkers = With[{tv = t /. var, gv = \[Gamma] /. var},
  Graphics[{
    If[EPexists[tv, gv], EPmarker[{EPreal[0, tv, gv], 0}, Green], {}],
    If[EPexists[tv, gv], EPmarker[{EPreal[1, tv, gv], 0}, Green], {}],
    If[EPexists[tv, gv], EPmarker[{EPreal[2, tv, gv], 0}, Green], {}]
  }]];

(*Fig. 2(b): no EP markers shown because gamma > t+t' places no real-kappa EP \
in BZ.*)
panelB = Show[
  ComplexListPlot[
    {enRPBCBlochPm0PanB, enRPBCBlochNm0PanB,
     enRPBCBlochPm1PanB, enRPBCBlochNm1PanB,
     enRPBCBlochPm2PanB, enRPBCBlochNm2PanB},
    Frame -> False, AspectRatio -> 1,
    PlotStyle -> {{Red,    PointSize[0.0125]}, {Red,    PointSize[0.0125]},
                  {Blue,   PointSize[0.0125]}, {Blue,   PointSize[0.0125]},
                  {Orange, PointSize[0.0125]}, {Orange, PointSize[0.0125]}},
    PlotLegends -> Placed[
      {\"m=0\", None, \"m=t'\", None, \"m=2t'\", None},
      {0.1, 0.15}],
    AxesLabel -> {\"Re[\[ScriptCapitalE]]/t'\", \
\"Im[\[ScriptCapitalE]]/t'\"},
    AspectRatio -> Automatic, PlotRange -> {Automatic},
    Background -> None],
  panelAmarkers,
  Graphics@Text[Style[\"(b)\", Large], {-3, 1.3}]
];\
\>", "Input",
 CellLabel->
  "In[575]:=",ExpressionUUID->"2333accc-166e-43e6-9913-f1c70d1c2df3"]
}, Open  ]],

Cell[CellGroupData[{

Cell["7. Panel C \[LongDash] complex spectrum, t=3/2, gamma=1.4", "Section",ExpressionUUID->"5cca5dff-d02e-4bd6-92ed-b497da18a0db"],

Cell["\<\
Panel (c) of Fig. 2: t=3/2 > t'=1. Now t > t' so the lower EP threshold
is gamma_c(pi) = |t - t'| = 0.5 and the upper is gamma_c(0) = t+t' = 2.5.
At gamma=1.4 the system is between the two thresholds.\
\>", "Text",ExpressionUUID->"fe163b48-c7b5-4a2d-b8eb-81c46059edf0"],

Cell["\<\
(*Parameters for panel (c): t raised to 3/2, same gamma = 1.4.*)
var = {t -> 3/2, tp -> 1, \[Gamma] -> 14/10, \[Epsilon]p -> 1, nn -> 500};

enRPBCBlochPm0PanC = Table[(\[Epsilon]p - 2 m Cos[\[Kappa]] -
    Sqrt[t^2 + tp^2 - \[Gamma]^2 + 2 t tp Cos[\[Kappa]]]) /. var /. m -> 0,
  {\[Kappa], -\[Pi], \[Pi], 2\[Pi]/(nn /. var)}];
enRPBCBlochNm0PanC = Table[(\[Epsilon]p - 2 m Cos[\[Kappa]] +
    Sqrt[t^2 + tp^2 - \[Gamma]^2 + 2 t tp Cos[\[Kappa]]]) /. var /. m -> 0,
  {\[Kappa], -\[Pi], \[Pi], 2\[Pi]/(nn /. var)}];
enRPBCBlochPm1PanC = Table[(\[Epsilon]p - 2 m Cos[\[Kappa]] -
    Sqrt[t^2 + tp^2 - \[Gamma]^2 + 2 t tp Cos[\[Kappa]]]) /. var /. m -> 1,
  {\[Kappa], -\[Pi], \[Pi], 2\[Pi]/(nn /. var)}];
enRPBCBlochNm1PanC = Table[(\[Epsilon]p - 2 m Cos[\[Kappa]] +
    Sqrt[t^2 + tp^2 - \[Gamma]^2 + 2 t tp Cos[\[Kappa]]]) /. var /. m -> 1,
  {\[Kappa], -\[Pi], \[Pi], 2\[Pi]/(nn /. var)}];
enRPBCBlochPm2PanC = Table[(\[Epsilon]p - 2 m Cos[\[Kappa]] -
    Sqrt[t^2 + tp^2 - \[Gamma]^2 + 2 t tp Cos[\[Kappa]]]) /. var /. m -> 2,
  {\[Kappa], -\[Pi], \[Pi], 2\[Pi]/(nn /. var)}];
enRPBCBlochNm2PanC = Table[(\[Epsilon]p - 2 m Cos[\[Kappa]] +
    Sqrt[t^2 + tp^2 - \[Gamma]^2 + 2 t tp Cos[\[Kappa]]]) /. var /. m -> 2,
  {\[Kappa], -\[Pi], \[Pi], 2\[Pi]/(nn /. var)}];

panelAmarkers = With[{tv = t /. var, gv = \[Gamma] /. var},
  Graphics[{
    If[EPexists[tv, gv], EPmarker[{EPreal[0, tv, gv], 0}, Green], {}],
    If[EPexists[tv, gv], EPmarker[{EPreal[1, tv, gv], 0}, Green], {}],
    If[EPexists[tv, gv], EPmarker[{EPreal[2, tv, gv], 0}, Green], {}]
  }]];

(*Fig. 2(c): t=3/2 places EP markers at different Re[E] positions than panel \
(a).*)
panelC = Show[
  ComplexListPlot[
    {enRPBCBlochPm0PanC, enRPBCBlochNm0PanC,
     enRPBCBlochPm1PanC, enRPBCBlochNm1PanC,
     enRPBCBlochPm2PanC, enRPBCBlochNm2PanC},
    Frame -> False, AspectRatio -> 1,
    PlotStyle -> {{Red,    PointSize[0.0125]}, {Red,    PointSize[0.0125]},
                  {Blue,   PointSize[0.0125]}, {Blue,   PointSize[0.0125]},
                  {Orange, PointSize[0.0125]}, {Orange, PointSize[0.0125]}},
    PlotLegends -> Placed[
      {\"m=0\", None, \"m=t'\", None, \"m=2t'\", None},
      {0.1, 0.15}],
    AxesLabel -> {\"Re[\[ScriptCapitalE]]/t'\", \
\"Im[\[ScriptCapitalE]]/t'\"},
    AspectRatio -> Automatic, PlotRange -> {Automatic},
    Background -> None],
  panelAmarkers,
  Graphics@Text[Style[\"(c)\", Large], {-3, 1.3}]
];\
\>", "Input",
 CellLabel->
  "In[590]:=",ExpressionUUID->"1b71ea35-35c9-47c8-896c-872f68e37df3"]
}, Open  ]],

Cell[CellGroupData[{

Cell["8. Panel D \[LongDash] complex spectrum, t=3/2, gamma=1.6", "Section",ExpressionUUID->"c9dd5707-e154-4e22-a2b5-4888dd68c423"],

Cell["\<\
Panel (d) of Fig. 2: t=3/2, gamma=1.6 \[LongDash] still within the EP window
[|t-t'|, t+t'] = [0.5, 2.5]. Compare with panel (b): different EP positions
due to the larger NN hopping t.\
\>", "Text",ExpressionUUID->"60e31fa9-8e62-41a9-a1ed-f7a8401a596e"],

Cell["\<\
(*Parameters for panel (d): t=3/2, gamma=1.6.*)
var = {t -> 3/2, tp -> 1, \[Gamma] -> 16/10, \[Epsilon]p -> 1, nn -> 500};

enRPBCBlochPm0PanD = Table[(\[Epsilon]p - 2 m Cos[\[Kappa]] -
    Sqrt[t^2 + tp^2 - \[Gamma]^2 + 2 t tp Cos[\[Kappa]]]) /. var /. m -> 0,
  {\[Kappa], -\[Pi], \[Pi], 2\[Pi]/(nn /. var)}];
enRPBCBlochNm0PanD = Table[(\[Epsilon]p - 2 m Cos[\[Kappa]] +
    Sqrt[t^2 + tp^2 - \[Gamma]^2 + 2 t tp Cos[\[Kappa]]]) /. var /. m -> 0,
  {\[Kappa], -\[Pi], \[Pi], 2\[Pi]/(nn /. var)}];
enRPBCBlochPm1PanD = Table[(\[Epsilon]p - 2 m Cos[\[Kappa]] -
