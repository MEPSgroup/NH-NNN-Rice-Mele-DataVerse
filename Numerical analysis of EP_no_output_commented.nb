Cell["\<\
disc2ROBCmf[tv_, tpv_, \[Gamma]v_, mv_] := disc2ROBCm /. {t -> tv, tp -> tpv, \
\[Gamma] -> \[Gamma]v, m -> mv}\
\>", "Input",
 CellLabel->
  "In[287]:=",ExpressionUUID->"21488c0a-e4b5-4c94-8c45-9543e31526d9"],

Cell["(* SVD grid for N=2 OBC, m=1, \[Gamma]=1. *)", "Input",
 CellLabel->
  "In[288]:=",ExpressionUUID->"370a9f9b-099d-4757-a5c2-16af8d42c299"],

Cell["\<\
svd2OBCm = With[{\[Delta] = 0.023},
  Flatten[ParallelTable[
    {t, tp, logSVDmin[Hamn2ROBCm, t, tp, 1, 1]},
    {t, -5, 5, \[Delta]}, {tp, -5, 5, \[Delta]}], 1]];\
\>", "Input",
 CellLabel->
  "In[289]:=",ExpressionUUID->"bb47c419-2093-4f75-8437-a603b21ee0fd"],

Cell["\<\
(* Density plot for N=2 OBC, m=1 with analytical contour.
   Controlled by showPlots. *)\
\>", "Input",
 CellLabel->
  "In[290]:=",ExpressionUUID->"eafa59fd-ec61-413e-a65b-3c40061eb647"],

Cell["\<\
If[showPlots,
  Show[
    ListDensityPlot[svd2OBCm,
      PlotRangePadding -> None,
      ColorFunction -> \"AvocadoColors\",
      FrameLabel -> {\"t/\[Gamma]\", \"t'/\[Gamma]\"},
      PlotLegends -> BarLegend[Automatic,
        LabelStyle -> {FontFamily -> \"Latin Modern Roman\", FontSize -> 24,
                        FontColor -> Black},
        LegendLabel -> Style[\"log10 \[Kappa](U)\",
          FontFamily -> \"Latin Modern Roman\", FontSize -> 26]],
      PlotRange -> Automatic],
    ContourPlot[disc2ROBCmf[t, tp, 1, 1] == 0, {t, -5, 5}, {tp, -5, 5},
      PlotPoints -> 100,
      ContourStyle -> {Black, AbsoluteThickness[1.5], Dashed}]],
  Null]\
\>", "Input",
 CellLabel->
  "In[291]:=",ExpressionUUID->"4525be33-7a36-4ee8-8274-f9522fab7105"]
}, Open  ]]
}, Open  ]]
}, Open  ]],

