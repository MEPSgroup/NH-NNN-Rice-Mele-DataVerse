Cell[CellGroupData[{

Cell["N = 9 & 10 case, m \[NotEqual] 0", "Section",
 CellChangeTimes->{{3.988440273572053*^9, 3.9884402836504097`*^9}, {
  3.999580358512536*^9, 
  3.9995803608120537`*^9}},ExpressionUUID->"682b1df4-d193-4305-81db-\
295cbf441135"],

Cell["\<\
(* Large-system cases N=9 and N=10 with m\[NotEqual]0.
   At larger N the finite-size EP pattern approaches the bulk limit more \
closely.
   We compute logSVDmin on a coarser grid to manage run-time.
   Density plots are most meaningful here since analytical formulae become
   unwieldy. All plots are controlled by showPlots. *)\
\>", "Input",
 CellLabel->
  "In[378]:=",ExpressionUUID->"79390146-49da-47da-8089-f33f82e152f6"],

Cell[CellGroupData[{

