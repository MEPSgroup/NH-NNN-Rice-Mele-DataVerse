        LabelStyle -> {FontFamily -> \"Latin Modern Roman\", FontSize -> 14},
        LegendLabel -> Style[\"log10 \[Sigma]min\",
          FontFamily -> \"Latin Modern Roman\", FontSize -> 14]],
      PlotRange -> Automatic],
    ContourPlot[disc2RPBCmf[t, tp, 1, 1] == 0, {t, -5, 5}, {tp, -5, 5},
      PlotPoints -> 100,
      ContourStyle -> {Black, AbsoluteThickness[1.5], Dashed}]],
  Null]\
\>", "Input",
 CellChangeTimes->{{3.999580272739249*^9, 3.999580292226776*^9}},
 CellLabel->
  "In[254]:=",ExpressionUUID->"006e954e-ba95-4371-b74f-902696350a73"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Case of Jordan decomposition at m = 0", "Subsubsection",
 CellChangeTimes->{{3.988440349006702*^9, 
  3.988440358135495*^9}},ExpressionUUID->"3ced2615-45b3-4386-bbe9-\
3eb4cdfb8aa6"],

Cell["\<\
(* At the exceptional point two eigenvalues and their eigenvectors
   merge. The Jordan normal form J has a 2x2 Jordan block:
   J = {{E_EP, 1}, {0, E_EP}} for the degenerate pair.
   This section verifies the EP numerically via JordanDecomposition. *)\
\>", "Input",
 CellLabel->
  "In[255]:=",ExpressionUUID->"d2003ca5-380b-4423-96d4-a045806483b1"],

Cell["\<\
(* Verify EP by Jordan decomposition for specific parameter values
   satisfying |t - t'| = \[Gamma] (here t=1/2, t'=1, \[Gamma]=1/2). *)\
\>", "Input",
 CellLabel->
  "In[256]:=",ExpressionUUID->"d3aafb0a-136d-471a-922d-37c9bb1447f3"],

Cell[CellGroupData[{

Cell["\<\
{Sjordan2, Jjordan2} = JordanDecomposition[
  N[Hamn2RPBCm0 /. {t -> 1/2, tp -> 1, \[Gamma] -> 1/2, m -> 0,
                    \[Epsilon]p -> 0, \[Epsilon]m -> 0}]];
Jjordan2  (* Jordan block structure confirms EP *)\
\>", "Input",
 CellLabel->
  "In[257]:=",ExpressionUUID->"1c675ad7-89cb-4f26-82d6-03b3ae54f8ac"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{"-", "1.4142135623730967`"}], "-", 
      RowBox[{"2.0383000842727483`*^-17", " ", "\[ImaginaryI]"}]}], ",", "0", 
     ",", "0", ",", "0"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"0", ",", "1.414213562373095`", ",", "0", ",", "0"}], "}"}], ",", 
   
   RowBox[{"{", 
    RowBox[{"0", ",", "0", ",", 
     RowBox[{"2.731932314335691`*^-9", "-", 
      RowBox[{"9.634810356104755`*^-9", " ", "\[ImaginaryI]"}]}], ",", "0"}], 
    "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"0", ",", "0", ",", "0", ",", 
     RowBox[{
      RowBox[{"-", "2.7319324387422837`*^-9"}], "+", 
      RowBox[{"9.634810289969557`*^-9", " ", "\[ImaginaryI]"}]}]}], "}"}]}], 
  "}"}]], "Output",
 CellChangeTimes->{3.99933567449468*^9, 3.999580263775249*^9, 
  3.999580297353653*^9},
 CellLabel->
  "Out[258]=",ExpressionUUID->"0ce3eeb2-74b8-4086-b3dc-00000731c236"]
}, Open  ]],

Cell["\<\
(* Confirm the 2x2 Jordan block in the degenerate subspace. *)\
\>", "Input",
 CellLabel->
  "In[259]:=",ExpressionUUID->"6413f2f6-94ee-41fa-bc3d-4cc41cf21942"],

Cell["If[showPlots, MatrixForm[Jjordan2], Null]", "Input",
 CellLabel->
  "In[260]:=",ExpressionUUID->"616e6811-8dd9-437f-9099-e65a2850686f"],

Cell["\<\

Null\
\>", "Input",
 CellLabel->
  "In[261]:=",ExpressionUUID->"cc69fbe6-6486-4cdc-bcda-c723397dab49"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["Open boundary condition case", "Subsection",
 CellChangeTimes->{{3.98844029114736*^9, 
  3.9884403025389853`*^9}},ExpressionUUID->"71c886c2-0d03-41be-88cc-\
fd16ac5aeb88"],

Cell[CellGroupData[{

Cell["Case m = 0", "Subsubsection",
 CellChangeTimes->{{3.988440349006702*^9, 
  3.988440358135495*^9}},ExpressionUUID->"61fd736f-fb75-4d63-be5e-\
b83f552180ed"],

Cell["\<\
(* N=2 OBC Hamiltonian (BC=0): no periodic wrap-around terms.
   In OBC the boundary mixes bulk EP conditions with surface effects.
   Eigenvalues are more complex than the PBC case (nested square roots). *)\
\>", "Input",
 CellLabel->
  "In[263]:=",ExpressionUUID->"bca8f0bc-e06a-4c71-bd5c-e0f81af5bdbb"],

Cell["\<\
Hamn2ROBCm0 = hamTB[2, 0] /. {\[Epsilon]p -> 0, \[Epsilon]m -> 0, m -> 0};
MatrixForm[Hamn2ROBCm0];
{en2ROBCm0, vec2ROBCm0} = FullSimplify[
  Eigensystem[Hamn2ROBCm0],
  Assumptions -> {Im[t] == 0, Re[t] > 0, Im[tp] == 0, Re[tp] > 0,
                  Im[\[Gamma]] == 0, Re[\[Gamma]] > 0, Im[m] == 0, Re[m] > \
0}];\
\>", "Input",
 CellChangeTimes->{{3.99933562208689*^9, 3.999335622088657*^9}},
 CellLabel->
  "In[264]:=",ExpressionUUID->"2d48d59b-dd7b-485d-8dd8-05a6034624c0"],

Cell[CellGroupData[{

Cell["en2ROBCm0", "Input",
 CellLabel->
  "In[267]:=",ExpressionUUID->"a49e7e6c-b96f-4e64-9b07-cb2719adea78"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"-", 
    FractionBox[
     SqrtBox[
      RowBox[{
       RowBox[{"2", " ", 
        SuperscriptBox["t", "2"]}], "+", 
       SuperscriptBox["tp", "2"], "-", 
       RowBox[{"tp", " ", 
        SqrtBox[
         RowBox[{
          RowBox[{"4", " ", 
           SuperscriptBox["t", "2"]}], "+", 
          SuperscriptBox["tp", "2"]}]]}], "-", 
       RowBox[{"2", " ", 
        SuperscriptBox["\[Gamma]", "2"]}]}]], 
     SqrtBox["2"]]}], ",", 
   FractionBox[
    SqrtBox[
     RowBox[{
      RowBox[{"2", " ", 
       SuperscriptBox["t", "2"]}], "+", 
      SuperscriptBox["tp", "2"], "-", 
      RowBox[{"tp", " ", 
       SqrtBox[
        RowBox[{
         RowBox[{"4", " ", 
          SuperscriptBox["t", "2"]}], "+", 
         SuperscriptBox["tp", "2"]}]]}], "-", 
      RowBox[{"2", " ", 
       SuperscriptBox["\[Gamma]", "2"]}]}]], 
    SqrtBox["2"]], ",", 
   RowBox[{"-", 
    SqrtBox[
     RowBox[{
      SuperscriptBox["t", "2"], "+", 
      RowBox[{
       FractionBox["1", "2"], " ", "tp", " ", 
       RowBox[{"(", 
        RowBox[{"tp", "+", 
         SqrtBox[
          RowBox[{
           RowBox[{"4", " ", 
            SuperscriptBox["t", "2"]}], "+", 
           SuperscriptBox["tp", "2"]}]]}], ")"}]}], "-", 
      SuperscriptBox["\[Gamma]", "2"]}]]}], ",", 
   SqrtBox[
    RowBox[{
     SuperscriptBox["t", "2"], "+", 
     RowBox[{
      FractionBox["1", "2"], " ", "tp", " ", 
      RowBox[{"(", 
       RowBox[{"tp", "+", 
        SqrtBox[
         RowBox[{
          RowBox[{"4", " ", 
           SuperscriptBox["t", "2"]}], "+", 
          SuperscriptBox["tp", "2"]}]]}], ")"}]}], "-", 
     SuperscriptBox["\[Gamma]", "2"]}]]}], "}"}]], "Output",
 CellChangeTimes->{3.999335675193746*^9, 3.99958026451788*^9, 
  3.9995802980580807`*^9},
 CellLabel->
  "Out[267]=",ExpressionUUID->"e574be73-2337-4c2d-abed-e0a62286ca3b"]
}, Open  ]],

Cell["(* Characteristic polynomial for N=2 OBC, m=0. *)", "Input",
 CellLabel->
  "In[268]:=",ExpressionUUID->"69c672c3-07e2-4ad2-a9a8-40a4efa8f32d"],

Cell[CellGroupData[{

Cell["\<\
eqsec2ROBCm0 = Det[Hamn2ROBCm0 - \[Lambda] IdentityMatrix[4]] // FullSimplify\
\
\>", "Input",
 CellLabel->
  "In[269]:=",ExpressionUUID->"e928b49a-44b4-43fe-90e8-f23b649f371c"],

Cell[BoxData[
 RowBox[{
  SuperscriptBox["t", "4"], "-", 
  RowBox[{"2", " ", 
   SuperscriptBox["t", "2"], " ", 
   RowBox[{"(", 
    RowBox[{
     SuperscriptBox["\[Gamma]", "2"], "+", 
     SuperscriptBox["\[Lambda]", "2"]}], ")"}]}], "-", 
  RowBox[{
   RowBox[{"(", 
    RowBox[{
     SuperscriptBox["tp", "2"], "-", 
     SuperscriptBox["\[Gamma]", "2"], "-", 
     SuperscriptBox["\[Lambda]", "2"]}], ")"}], " ", 
   RowBox[{"(", 
    RowBox[{
     SuperscriptBox["\[Gamma]", "2"], "+", 
     SuperscriptBox["\[Lambda]", "2"]}], ")"}]}]}]], "Output",
 CellChangeTimes->{3.999335675203579*^9, 3.999580264529311*^9, 
  3.9995802980683928`*^9},
 CellLabel->
  "Out[269]=",ExpressionUUID->"4d8878bc-893c-4b7f-9d6a-cd4bf1e012f6"]
}, Open  ]],

Cell["(* Discriminant of OBC characteristic polynomial. *)", "Input",
 CellLabel->
  "In[270]:=",ExpressionUUID->"0e6c867b-5ef7-4401-a268-fcce6d3b2b91"],

Cell[CellGroupData[{

Cell["disc2ROBCm0 = Discriminant[eqsec2ROBCm0, \[Lambda]] // FullSimplify", \
"Input",
 CellLabel->
  "In[271]:=",ExpressionUUID->"9987948d-2012-47b8-bf51-2f406167f1e4"],

Cell[BoxData[
 RowBox[{"16", " ", 
  SuperscriptBox[
   RowBox[{"(", 
    RowBox[{
     RowBox[{"4", " ", 
      SuperscriptBox["t", "2"], " ", 
      SuperscriptBox["tp", "2"]}], "+", 
     SuperscriptBox["tp", "4"]}], ")"}], "2"], " ", 
  RowBox[{"(", 
   RowBox[{
    SuperscriptBox["t", "4"], "-", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{"2", " ", 
        SuperscriptBox["t", "2"]}], "+", 
       SuperscriptBox["tp", "2"]}], ")"}], " ", 
     SuperscriptBox["\[Gamma]", "2"]}], "+", 
    SuperscriptBox["\[Gamma]", "4"]}], ")"}]}]], "Output",
 CellChangeTimes->{3.9993356752212467`*^9, 3.9995802645459337`*^9, 
  3.9995802980803432`*^9},
 CellLabel->
  "Out[271]=",ExpressionUUID->"8ea2e887-f955-4730-bf23-8be476a7819d"]
}, Open  ]],

Cell["\<\
disc2ROBCm0f[tv_, tpv_, \[Gamma]v_] := disc2ROBCm0 /. {t -> tv, tp -> tpv, \
\[Gamma] -> \[Gamma]v}\
\>", "Input",
 CellLabel->
  "In[272]:=",ExpressionUUID->"c71f9a41-be7d-4b69-b920-ae13c8da7f65"],

Cell["\<\
(* ContourPlot of the OBC EP locus for \[Gamma]=1.
   Compare with the PBC contour to see finite-size boundary effects. *)\
\>", "Input",
 CellLabel->
  "In[273]:=",ExpressionUUID->"17a2436e-af86-4e5f-8756-43370c84db78"],

Cell["\<\
If[showPlots,
  With[{\[Gamma] = 1},
    ContourPlot[disc2ROBCm0f[t, tp, 1] == 0, {t, -4, 4}, {tp, -4, 4},
      PlotPoints -> 120,
      FrameLabel -> {\"t/\[Gamma]\", \"t'/\[Gamma]\"},
      PlotRangePadding -> None]],
  Null]\
\>", "Input",
 CellLabel->
  "In[274]:=",ExpressionUUID->"2e257d83-00d7-48a4-89be-dde84e76d4dd"],

Cell["(* SVD grid for N=2 OBC, m=0, \[Gamma]=1. *)", "Input",
 CellLabel->
  "In[275]:=",ExpressionUUID->"c15a6840-62ac-4831-91ce-7b23973803db"],

Cell["\<\
svd2OBCm0 = With[{\[Delta] = 0.23/10},
  Flatten[ParallelTable[
    {t, tp, logSVDmin[Hamn2ROBCm0, t, tp, 1, 0]},
    {t, -5, 5, \[Delta]}, {tp, -5, 5, \[Delta]}], 1]];\
\>", "Input",
 CellLabel->
  "In[276]:=",ExpressionUUID->"1fbabcea-262e-42bb-bb6e-98ad8f26c666"],

Cell["\<\
(* Density plot for N=2 OBC, m=0 with analytical EP contour.
   Controlled by showPlots. *)\
\>", "Input",
 CellLabel->
  "In[277]:=",ExpressionUUID->"091389d2-1f1b-47f1-a85b-7c1076b63c66"],

Cell["\<\
If[showPlots,
  Show[
    ListDensityPlot[svd2OBCm0,
      PlotRangePadding -> None,
      ColorFunction -> \"AvocadoColors\",
      FrameLabel -> {\"t/\[Gamma]\", \"t'/\[Gamma]\"},
      PlotLegends -> BarLegend[Automatic,
        LabelStyle -> {FontFamily -> \"Latin Modern Roman\", FontSize -> 24,
                        FontColor -> Black},
        LegendLabel -> Style[\"log10 \[Kappa](U)\",
          FontFamily -> \"Latin Modern Roman\", FontSize -> 26]],
      PlotRange -> {0, 2}],
    ContourPlot[disc2ROBCm0f[t, tp, 1] == 0, {t, -5, 5}, {tp, -5, 5},
      PlotPoints -> 100,
      ContourStyle -> {Black, AbsoluteThickness[0.8], Dashed}]],
  Null]\
\>", "Input",
 CellLabel->
  "In[278]:=",ExpressionUUID->"808c5b92-0ff1-436d-addf-d5a6726b0a6e"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Case m \[NotEqual] 0", "Subsubsection",
 CellChangeTimes->{{3.988440349006702*^9, 3.988440358135495*^9}, {
  3.99958041624083*^9, 
  3.999580417155939*^9}},ExpressionUUID->"5b8224ff-f832-4e60-9a48-\
6d5ba995d34b"],

Cell["\<\
(* N=2 OBC, m\[NotEqual]0: the NNN on-site coupling m shifts eigenvalues and
   modifies the EP locus in finite systems.  This is the case that shows
   the key difference between PBC and OBC for finite size N.  *)\
\>", "Input",
 CellLabel->
  "In[281]:=",ExpressionUUID->"1f07857a-8aea-428a-9386-b16699b4bfeb"],

Cell["\<\
Hamn2ROBCm = hamTB[2, 0] /. {\[Epsilon]p -> 0, \[Epsilon]m -> 0};
MatrixForm[Hamn2ROBCm];
(* The eigensystem is not evaluated symbolically: for m\[NotEqual]0 the OBC   \
 Hamiltonian has no known compact closed-form eigenvalues (arXiv:2606.24705). \
   EP detection proceeds via the discriminant and logSVDmin below. *)\
\>", "Input",
 CellChangeTimes->{{3.999335623485229*^9, 3.999335623487316*^9}},
 CellLabel->
  "In[282]:=",ExpressionUUID->"d535c02d-1f15-4b46-bda3-8f9922148c21"],

Cell[CellGroupData[{

Cell["\<\
eqsec2ROBCm = Det[Hamn2ROBCm - \[Lambda] IdentityMatrix[4]] // FullSimplify\
\>", "Input",
 CellLabel->
  "In[285]:=",ExpressionUUID->"ede2e3d4-d1bb-4873-a334-3deea0aa8f4b"],

Cell[BoxData[
 RowBox[{
  SuperscriptBox["m", "4"], "+", 
  SuperscriptBox["t", "4"], "+", 
  RowBox[{"4", " ", "m", " ", "t", " ", "tp", " ", "\[Lambda]"}], "-", 
  RowBox[{"2", " ", 
   SuperscriptBox["m", "2"], " ", 
   RowBox[{"(", 
    RowBox[{
     SuperscriptBox["t", "2"], "-", 
     SuperscriptBox["\[Gamma]", "2"], "+", 
     SuperscriptBox["\[Lambda]", "2"]}], ")"}]}], "-", 
  RowBox[{"2", " ", 
   SuperscriptBox["t", "2"], " ", 
   RowBox[{"(", 
    RowBox[{
     SuperscriptBox["\[Gamma]", "2"], "+", 
     SuperscriptBox["\[Lambda]", "2"]}], ")"}]}], "-", 
  RowBox[{
   RowBox[{"(", 
    RowBox[{
     SuperscriptBox["tp", "2"], "-", 
     SuperscriptBox["\[Gamma]", "2"], "-", 
     SuperscriptBox["\[Lambda]", "2"]}], ")"}], " ", 
   RowBox[{"(", 
    RowBox[{
     SuperscriptBox["\[Gamma]", "2"], "+", 
     SuperscriptBox["\[Lambda]", "2"]}], ")"}]}]}]], "Output",
 CellChangeTimes->{3.999580264959199*^9, 3.9995802984955673`*^9},
 CellLabel->
  "Out[285]=",ExpressionUUID->"61168f8f-7c91-4a9e-8146-d15013e2b91f"]
}, Open  ]],

Cell[CellGroupData[{

Cell["disc2ROBCm = Discriminant[eqsec2ROBCm, \[Lambda]] // FullSimplify", \
"Input",
 CellLabel->
  "In[286]:=",ExpressionUUID->"d2aed968-667e-4632-9f6e-7039afac3872"],

Cell[BoxData[
 RowBox[{"16", " ", 
  RowBox[{"(", 
   RowBox[{
    RowBox[{
     SuperscriptBox["tp", "4"], " ", 
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{
        RowBox[{"4", " ", 
         SuperscriptBox["t", "2"]}], "+", 
        SuperscriptBox["tp", "2"]}], ")"}], "2"], " ", 
     RowBox[{"(", 
      RowBox[{
       SuperscriptBox["t", "4"], "-", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"2", " ", 
           SuperscriptBox["t", "2"]}], "+", 
          SuperscriptBox["tp", "2"]}], ")"}], " ", 
        SuperscriptBox["\[Gamma]", "2"]}], "+", 
       SuperscriptBox["\[Gamma]", "4"]}], ")"}]}], "+", 
    RowBox[{"16", " ", 
     SuperscriptBox["m", "8"], " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"16", " ", 
        SuperscriptBox["t", "4"]}], "+", 
       SuperscriptBox[
        RowBox[{"(", 
         RowBox[{
          SuperscriptBox["tp", "2"], "-", 
          RowBox[{"4", " ", 
           SuperscriptBox["\[Gamma]", "2"]}]}], ")"}], "2"], "-", 
       RowBox[{"8", " ", 
        SuperscriptBox["t", "2"], " ", 
        RowBox[{"(", 
         RowBox[{
          SuperscriptBox["tp", "2"], "+", 
          RowBox[{"4", " ", 
           SuperscriptBox["\[Gamma]", "2"]}]}], ")"}]}]}], ")"}]}], "-", 
    RowBox[{"8", " ", 
     SuperscriptBox["m", "6"], " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"64", " ", 
        SuperscriptBox["t", "6"]}], "-", 
       SuperscriptBox["tp", "6"], "+", 
       RowBox[{"32", " ", 
