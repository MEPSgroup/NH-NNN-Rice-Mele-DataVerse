Cell[CellGroupData[{

Cell["Case m = 0", "Subsubsection",
 CellChangeTimes->{{3.988440349006702*^9, 
  3.988440358135495*^9}},ExpressionUUID->"148f5c0b-f04b-49e5-b90e-\
40697a19ba4b"],

Cell["\<\
(* N=3 PBC Hamiltonian at m=0: a 6x6 matrix.
   The three quasi-momenta accessible are k=0, 2\[Pi]/3, 4\[Pi]/3, giving six
   eigenvalues. EP conditions now depend on these three k-values.
   Eigenvalues at m=0: \[PlusMinus]Sqrt[t^2 - t t' + t'^2 - \[Gamma]^2] \
(double) and
   \[PlusMinus]Sqrt[(t+t')^2 - \[Gamma]^2] (single pair). *)\
\>", "Input",
 CellLabel->
  "In[296]:=",ExpressionUUID->"d5fe9ea6-6956-4ab8-9b99-e6749015ca65"],

Cell[CellGroupData[{

Cell["\<\
Hamn3RPBCm0 = hamTB[3, 1] /. {\[Epsilon]p -> 0, \[Epsilon]m -> 0, m -> 0};
MatrixForm[Hamn3RPBCm0]\
\>", "Input",
 CellChangeTimes->{{3.999335624370946*^9, 3.9993356243730717`*^9}},
 CellLabel->
  "In[297]:=",ExpressionUUID->"5ba7501d-39c6-4994-87e0-cdacd99e7d85"],

Cell[BoxData[
 TagBox[
  RowBox[{"(", "\[NoBreak]", GridBox[{
     {
      RowBox[{"\[ImaginaryI]", " ", "\[Gamma]"}], 
      RowBox[{"-", "t"}], "0", "0", "0", 
      RowBox[{"-", "tp"}]},
     {
      RowBox[{"-", "t"}], 
      RowBox[{
       RowBox[{"-", "\[ImaginaryI]"}], " ", "\[Gamma]"}], 
      RowBox[{"-", "tp"}], "0", "0", "0"},
     {"0", 
      RowBox[{"-", "tp"}], 
      RowBox[{"\[ImaginaryI]", " ", "\[Gamma]"}], 
      RowBox[{"-", "t"}], "0", "0"},
     {"0", "0", 
      RowBox[{"-", "t"}], 
      RowBox[{
       RowBox[{"-", "\[ImaginaryI]"}], " ", "\[Gamma]"}], 
      RowBox[{"-", "tp"}], "0"},
     {"0", "0", "0", 
      RowBox[{"-", "tp"}], 
      RowBox[{"\[ImaginaryI]", " ", "\[Gamma]"}], 
      RowBox[{"-", "t"}]},
     {
      RowBox[{"-", "tp"}], "0", "0", "0", 
      RowBox[{"-", "t"}], 
      RowBox[{
       RowBox[{"-", "\[ImaginaryI]"}], " ", "\[Gamma]"}]}
    },
    GridBoxAlignment->{"Columns" -> {{Center}}, "Rows" -> {{Baseline}}},
    GridBoxSpacings->{"Columns" -> {
        Offset[0.27999999999999997`], {
         Offset[0.7]}, 
        Offset[0.27999999999999997`]}, "Rows" -> {
        Offset[0.2], {
         Offset[0.4]}, 
        Offset[0.2]}}], "\[NoBreak]", ")"}],
  Function[BoxForm`e$, 
   MatrixForm[BoxForm`e$]]]], "Output",
 CellChangeTimes->{3.999580265613193*^9, 3.999580299087308*^9},
 CellLabel->
  "Out[298]//MatrixForm=",ExpressionUUID->"960c1ec8-cbc7-4949-b18a-\
7d879ddae763"]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
{en3, vec3} = Eigensystem[Hamn3RPBCm0];
en3\
\>", "Input",
 CellLabel->
  "In[299]:=",ExpressionUUID->"f37bbafb-541c-4cc7-9af3-aeae10ef2469"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"-", 
    SqrtBox[
     RowBox[{
      SuperscriptBox["t", "2"], "-", 
      RowBox[{"t", " ", "tp"}], "+", 
      SuperscriptBox["tp", "2"], "-", 
      SuperscriptBox["\[Gamma]", "2"]}]]}], ",", 
   RowBox[{"-", 
    SqrtBox[
     RowBox[{
      SuperscriptBox["t", "2"], "-", 
      RowBox[{"t", " ", "tp"}], "+", 
      SuperscriptBox["tp", "2"], "-", 
      SuperscriptBox["\[Gamma]", "2"]}]]}], ",", 
   SqrtBox[
    RowBox[{
     SuperscriptBox["t", "2"], "-", 
     RowBox[{"t", " ", "tp"}], "+", 
     SuperscriptBox["tp", "2"], "-", 
     SuperscriptBox["\[Gamma]", "2"]}]], ",", 
   SqrtBox[
    RowBox[{
     SuperscriptBox["t", "2"], "-", 
     RowBox[{"t", " ", "tp"}], "+", 
     SuperscriptBox["tp", "2"], "-", 
     SuperscriptBox["\[Gamma]", "2"]}]], ",", 
   RowBox[{"-", 
    SqrtBox[
     RowBox[{
      SuperscriptBox["t", "2"], "+", 
      RowBox[{"2", " ", "t", " ", "tp"}], "+", 
      SuperscriptBox["tp", "2"], "-", 
      SuperscriptBox["\[Gamma]", "2"]}]]}], ",", 
   SqrtBox[
    RowBox[{
     SuperscriptBox["t", "2"], "+", 
     RowBox[{"2", " ", "t", " ", "tp"}], "+", 
     SuperscriptBox["tp", "2"], "-", 
     SuperscriptBox["\[Gamma]", "2"]}]]}], "}"}]], "Output",
 CellChangeTimes->{3.9995802656878967`*^9, 3.9995802991511183`*^9},
 CellLabel->
  "Out[300]=",ExpressionUUID->"027fd20a-3410-46f2-9152-a9a48a5c985a"]
}, Open  ]],

Cell["(* Characteristic polynomial for N=3 PBC, m=0. *)", "Input",
 CellLabel->
  "In[301]:=",ExpressionUUID->"f1542d90-07d8-49a8-b086-d005c229f55c"],

Cell[CellGroupData[{

Cell["\<\
eqsec3RPBCm0 = Det[Hamn3RPBCm0 - \[Lambda] \
IdentityMatrix[Length[Hamn3RPBCm0]]] // FullSimplify\
\>", "Input",
 CellLabel->
  "In[302]:=",ExpressionUUID->"dd6b54af-f984-4430-b2e9-e2ffcebb2cb4"],

Cell[BoxData[
 RowBox[{"-", 
  RowBox[{"(", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{"t", "+", "tp"}], ")"}], "2"], "-", 
      SuperscriptBox["\[Gamma]", "2"], "-", 
      SuperscriptBox["\[Lambda]", "2"]}], ")"}], " ", 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{
       RowBox[{"-", 
        SuperscriptBox["t", "2"]}], "+", 
       RowBox[{"t", " ", "tp"}], "-", 
       SuperscriptBox["tp", "2"], "+", 
       SuperscriptBox["\[Gamma]", "2"], "+", 
       SuperscriptBox["\[Lambda]", "2"]}], ")"}], "2"]}], ")"}]}]], "Output",
 CellChangeTimes->{3.999580265705887*^9, 3.999580299167201*^9},
 CellLabel->
  "Out[302]=",ExpressionUUID->"2186f38b-3f8e-4283-b4af-418c28616a58"]
}, Open  ]],

Cell["\<\
(* Discriminant of the N=3 PBC characteristic polynomial.
   The discriminant factors into contributions from each accessible k value. \
*)\
\>", "Input",
 CellLabel->
  "In[303]:=",ExpressionUUID->"18ec6dd4-3a08-4157-ac08-5eabd9791fd6"],

Cell[CellGroupData[{

Cell["disc3RPBCm0 = Discriminant[eqsec3RPBCm0, \[Lambda]] // FullSimplify", \
"Input",
 CellLabel->
  "In[304]:=",ExpressionUUID->"00f5661a-13b5-4444-9013-518dbed0ed1d"],

Cell[BoxData["0"], "Output",
 CellChangeTimes->{3.999580265714953*^9, 3.999580299176112*^9},
 CellLabel->
  "Out[304]=",ExpressionUUID->"6e50337a-d145-4982-b9c7-85ca77f154ff"]
}, Open  ]],

Cell["\<\
disc3RPBCm0f[tv_, tpv_, \[Gamma]v_] := disc3RPBCm0 /. {t -> tv, tp -> tpv, \
\[Gamma] -> \[Gamma]v}\
\>", "Input",
 CellLabel->
  "In[305]:=",ExpressionUUID->"9049fbf6-5e39-4296-ac3e-c390a6c53330"],

Cell["(* Solve for EP loci analytically (where possible). *)", "Input",
 CellLabel->
  "In[306]:=",ExpressionUUID->"84d180ad-d9da-431b-9b14-7f94cb676112"],

Cell[CellGroupData[{

Cell["\<\
sol3 = Solve[(t + tp - \[Gamma]) (t + tp + \[Gamma]) == 0 ||
              (t^2 - t tp + tp^2 - \[Gamma]^2) == 0, tp]\
\>", "Input",
 CellLabel->
  "In[307]:=",ExpressionUUID->"9049fbf6-5e39-4296-ac3e-c390a6c53332"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"tp", "\[Rule]", 
     RowBox[{
      RowBox[{"-", "t"}], "-", "\[Gamma]"}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"tp", "\[Rule]", 
     RowBox[{
      RowBox[{"-", "t"}], "+", "\[Gamma]"}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"tp", "\[Rule]", 
     RowBox[{
      FractionBox["1", "2"], " ", 
      RowBox[{"(", 
       RowBox[{"t", "-", 
        SqrtBox[
         RowBox[{
          RowBox[{
           RowBox[{"-", "3"}], " ", 
           SuperscriptBox["t", "2"]}], "+", 
          RowBox[{"4", " ", 
           SuperscriptBox["\[Gamma]", "2"]}]}]]}], ")"}]}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"tp", "\[Rule]", 
     RowBox[{
      FractionBox["1", "2"], " ", 
      RowBox[{"(", 
       RowBox[{"t", "+", 
        SqrtBox[
         RowBox[{
          RowBox[{
           RowBox[{"-", "3"}], " ", 
           SuperscriptBox["t", "2"]}], "+", 
          RowBox[{"4", " ", 
           SuperscriptBox["\[Gamma]", "2"]}]}]]}], ")"}]}]}], "}"}]}], 
  "}"}]], "Output",
 CellChangeTimes->{3.9995802657239113`*^9, 3.999580299187477*^9},
 CellLabel->
  "Out[307]=",ExpressionUUID->"f67c1797-5c50-435c-98f1-ba876954f0f3"]
}, Open  ]],

Cell["\<\
(* EP boundary lines for N=3 PBC, m=0 (\[Gamma]=1):
   t' = -t \[PlusMinus] \[Gamma] from (t+t')^2 = \[Gamma]^2, and two arcs \
from t^2-tt'+t'^2 = \[Gamma]^2. *)\
\>", "Input",
 CellLabel->
  "In[308]:=",ExpressionUUID->"768e5de8-e026-46e9-b340-2c10fa549d3a"],

Cell["\<\
With[{\[Gamma]val = 1},
  line1d3 = Table[{t, -t - \[Gamma]val}, {t, -5, 5, 1/4}];
  line2d3 = Table[{t, -t + \[Gamma]val}, {t, -5, 5, 1/4}];
  cupd3 = Table[{t, (1/2)(t + Sqrt[-3 t^2 + 4 \[Gamma]val^2])},
    {t, -15 \[Gamma]val, 15 \[Gamma]val, \[Gamma]val/20}];
  cdownd3 = Table[{t, (1/2)(t - Sqrt[-3 t^2 + 4 \[Gamma]val^2])},
    {t, -15 \[Gamma]val, 15 \[Gamma]val, \[Gamma]val/20}];
];\
\>", "Input",
 CellLabel->
  "In[309]:=",ExpressionUUID->"63b9a1a6-67ef-49f7-aabd-229577eeadb8"],

Cell["(* SVD grid for N=3 PBC, m=0. *)", "Input",
 CellLabel->
  "In[310]:=",ExpressionUUID->"28784e03-6240-4d6d-b585-29f22ab147e3"],

Cell["\<\
svd3PBCm0 = With[{\[Delta] = 0.023},
  Flatten[ParallelTable[
    {t, tp, logSVDmin[Hamn3RPBCm0, t, tp, 1, 0]},
    {t, -5, 5, \[Delta]}, {tp, -5, 5, \[Delta]}], 1]];\
\>", "Input",
 CellLabel->
  "In[311]:=",ExpressionUUID->"28f7d899-c18b-4ff0-ba65-3318573d282f"],

Cell["\<\
(* Density plot for N=3 PBC, m=0 overlaid with EP boundary curves.
   Controlled by showPlots. *)\
\>", "Input",
 CellLabel->
  "In[312]:=",ExpressionUUID->"2756b824-d399-4953-9803-3ecd000297d7"],

Cell["\<\
If[showPlots,
  Show[
    ListDensityPlot[svd3PBCm0,
      PlotRangePadding -> None,
      ColorFunction -> \"AvocadoColors\",
      FrameLabel -> {\"t/\[Gamma]\", \"t'/\[Gamma]\"},
      PlotLegends -> BarLegend[Automatic,
        LabelStyle -> {FontFamily -> \"Latin Modern Roman\", FontSize -> 26,
                        FontColor -> Black},
        LegendLabel -> Style[\"log10 \[Kappa](U)\",
          FontFamily -> \"Latin Modern Roman\", FontSize -> 26]],
      PlotRange -> {0, 2}],
    ListPlot[{line1d3, line2d3, cupd3, cdownd3},
      Joined -> True, PlotStyle -> {Black, AbsoluteThickness[0.8], Dashed}]],
  Null]\
\>", "Input",
 CellLabel->
  "In[313]:=",ExpressionUUID->"8d3d5fd7-4164-4996-92ce-eac761bddd26"],

Cell[CellGroupData[{

Cell["sol3", "Input",
 CellLabel->
  "In[314]:=",ExpressionUUID->"711254d1-e534-409d-9707-3f9823aa0041"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"tp", "\[Rule]", 
     RowBox[{
      RowBox[{"-", "t"}], "-", "\[Gamma]"}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"tp", "\[Rule]", 
     RowBox[{
      RowBox[{"-", "t"}], "+", "\[Gamma]"}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"tp", "\[Rule]", 
     RowBox[{
      FractionBox["1", "2"], " ", 
      RowBox[{"(", 
       RowBox[{"t", "-", 
        SqrtBox[
         RowBox[{
          RowBox[{
           RowBox[{"-", "3"}], " ", 
           SuperscriptBox["t", "2"]}], "+", 
          RowBox[{"4", " ", 
           SuperscriptBox["\[Gamma]", "2"]}]}]]}], ")"}]}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"tp", "\[Rule]", 
     RowBox[{
      FractionBox["1", "2"], " ", 
      RowBox[{"(", 
       RowBox[{"t", "+", 
        SqrtBox[
         RowBox[{
          RowBox[{
           RowBox[{"-", "3"}], " ", 
           SuperscriptBox["t", "2"]}], "+", 
          RowBox[{"4", " ", 
           SuperscriptBox["\[Gamma]", "2"]}]}]]}], ")"}]}]}], "}"}]}], 
  "}"}]], "Output",
 CellChangeTimes->{3.999580266225181*^9, 3.999580299699914*^9},
 CellLabel->
  "Out[314]=",ExpressionUUID->"2734bee4-b360-478a-9286-8259dfeb9725"]
}, Open  ]]
