Cell["\<\
SetOptions[ListPlot, BaseStyle -> {FontFamily -> \"Latin Modern Roman\", \
FontSize -> 14}, FrameStyle -> Directive[Black, FontColor -> Black]];
SetOptions[Plot, BaseStyle -> {FontFamily -> \"Latin Modern Roman\", FontSize \
-> 14}, FrameStyle -> Directive[Black, FontColor -> Black]];
SetOptions[ListLinePlot, BaseStyle -> {FontFamily -> \"Latin Modern Roman\", \
FontSize -> 14}, FrameStyle -> Directive[Black, FontColor -> Black], Frame -> \
True, Axes -> False];
SetOptions[ListPlot3D, BaseStyle -> {FontFamily -> \"Latin Modern Roman\", \
FontSize -> 14}, AxesStyle -> Directive[Black, FontColor -> Black]];
SetOptions[Plot3D, BaseStyle -> {FontFamily -> \"Latin Modern Roman\", \
FontSize -> 14}, AxesStyle -> Directive[Black, FontColor -> Black]];
SetOptions[ListDensityPlot, BaseStyle -> {FontFamily -> \"Latin Modern \
Roman\", FontSize -> 26}, FrameStyle -> Directive[Black, FontColor -> \
Black]];
SetOptions[ContourPlot, BaseStyle -> {FontFamily -> \"Latin Modern Roman\", \
FontSize -> 26}, FrameStyle -> Directive[Black, FontColor -> Black]];
SetOptions[RegionPlot, BaseStyle -> {FontFamily -> \"Latin Modern Roman\", \
FontSize -> 14}, FrameStyle -> Directive[Black, FontColor -> Black]];\
\>", "Input",
 CellLabel->
  "In[205]:=",ExpressionUUID->"2d3a2475-17b4-4ae9-8888-fb3b25187131"],

Cell["\<\
(* Physical context: we study exceptional points for finite-size
   Hamiltonians of the non-Hermitian long-range Rice-Mele model.
   Parameters: \[Epsilon]p (on-site average), \[Epsilon]m (sublattice \
offset), \[Gamma] (NH gain/loss),
   t (NN hopping), tp (NNN hopping), m (NNN on-site modulation).
   We set \[Epsilon]p = \[Epsilon]m = 0 throughout (shifts only) and compare \
PBC vs OBC.
   The main finding is that the NNN on-site term m plays a role in finite
   systems that is absent in the bulk limit. *)\
\>", "Text",
 CellChangeTimes->{{3.987667485395836*^9, 
  3.987667685709869*^9}},ExpressionUUID->"ab693d14-97b3-466f-9c34-\
6d7aa2da23ef"],

Cell["\<\
(* ============================================================
   SECTION 2: TIGHT-BINDING HAMILTONIAN hamTB[n, BC]
   ============================================================

   hamTB[n, BC] returns the 2n x 2n tight-binding matrix for n unit cells.
   BC = 1 -> periodic boundary conditions (PBC)
   BC = 0 -> open boundary conditions (OBC)

   Diagonal entries: (\[Epsilon]p + \[Epsilon]m + i\[Gamma]) for A sites, (\
\[Epsilon]p - \[Epsilon]m - i\[Gamma]) for B sites.
   Off-diagonal1 (nearest-neighbour, bands +/-1): alternating {-t, -tp}.
   Off-diagonal2 (next-nearest-neighbour, bands +/-2): constant -m.
   PBC wrap-arounds (bands 1,2n and 2n,1) add -tp and -m respectively. *)\
\>", "Input",
 CellLabel->
  "In[213]:=",ExpressionUUID->"ac24f86d-661f-4c15-8d27-3a177c16464a"],

Cell["\<\
hamTB[n_, BC_] := Module[{hamiltonian, umat, diag, offdiag1, offdiag2},
  (* On-site energies: +\[Epsilon]m+I\[Gamma] on A-sites, -\[Epsilon]m-I\
\[Gamma] on B-sites *)
  diag = DiagonalMatrix[
    Flatten[ConstantArray[{\[Epsilon]p + \[Epsilon]m + I \[Gamma], \
\[Epsilon]p - \[Epsilon]m - I \[Gamma]}, n]]];
  (* NN hopping: alternating -t (intra-cell) and -t' (inter-cell) along the \
chain *)
  offdiag1 = -Drop[Flatten[ConstantArray[{t, tp}, n]], -1];
  (* NNN hopping: uniform -m on the 2nd super/sub-diagonal; length 2n-2 fills \
the full diagonal *)
  offdiag2 = ConstantArray[-m, 2 n - 2];
  hamiltonian = diag
    + DiagonalMatrix[offdiag1, 1]
    + DiagonalMatrix[offdiag1, -1]
    + DiagonalMatrix[offdiag2, 2]
    + DiagonalMatrix[offdiag2, -2];
  (* PBC wrap-around NN hopping (arXiv:2606.24705, Eq.(1)): t' corner element \
*)
  If[BC == 1, hamiltonian[[1, 2 n]] = -tp, 0];
  If[BC == 1, hamiltonian[[2 n, 1]] = -tp, 0];
  (* PBC wrap-around NNN hopping (m corner elements; for n=2 these coincide \
with bulk diag) *)
  If[BC == 1, hamiltonian[[1, 2 n - 1]] = -m, 0];
  If[BC == 1, hamiltonian[[2, 2 n]] = -m, 0];
  If[BC == 1, hamiltonian[[2 n - 1, 1]] = -m, 0];
  If[BC == 1, hamiltonian[[2 n, 2]] = -m, 0];
  Return[hamiltonian]
];\
\>", "Input",
 CellLabel->
  "In[214]:=",ExpressionUUID->"15ca0f2f-362f-4c50-9508-f615f2533a09"],

Cell["\<\
(* ============================================================
   SECTION 3: EP DETECTOR logSVDmin[Ham, tv, tpv, \[Gamma]v, mv]
   ============================================================

   At an exceptional point the eigenvectors coalesce, making the matrix of
   right eigenvectors U (normalised column-wise) singular. The ratio
   \[Sigma]_max / \[Sigma]_min of its singular values diverges to +\[Infinity].

   logSVDmin returns log10(\[Sigma]_max / \[Sigma]_min) = log10(kappa(U))
   (arXiv:2606.24705, Eq.(10): condition number of the eigenvector matrix),
   which diverges at EPs and stays
   finite in the topological and trivial phases. It is used to produce the
   density-plot panels identifying EP loci in the (t/\[Gamma], t'/\[Gamma]) \
plane. *)\
\>", "Input",
 CellLabel->
  "In[215]:=",ExpressionUUID->"dfdb7a8e-47b6-44d4-ae9f-eb7bebb394b0"],

Cell["\<\
logSVDmin[Ham_, tv_, tpv_, \[Gamma]v_, mv_] := Module[{eR, vR, U, sv},
  {eR, vR} = Eigensystem[Ham /. {t -> tv, tp -> tpv, \[Gamma] -> \[Gamma]v, m \
-> mv}];
  U = Transpose[vR/(Norm /@ vR)];    (* normalised eigenvector matrix *)
  sv = SingularValueList[N[U]];
  Log[10, Max[sv]/Min[sv]]           (* diverges to +\[Infinity] at EP *)
];\
\>", "Input",
 CellLabel->
  "In[216]:=",ExpressionUUID->"ab419e2d-4f90-49f1-82e9-2ba1da10aa34"],

Cell[CellGroupData[{

Cell["Case with N = 2", "Section",
 CellChangeTimes->{{3.988440273572053*^9, 
  3.9884402836504097`*^9}},ExpressionUUID->"6975cc7d-32cb-471f-8328-\
1a4c563f527d"],

Cell[CellGroupData[{

Cell["Periodic boundary condition case", "Subsection",
 CellChangeTimes->{{3.98844029114736*^9, 
  3.9884403025389853`*^9}},ExpressionUUID->"d16fca0b-6a40-4721-9414-\
b012e99245f5"],

Cell[CellGroupData[{

Cell["Case m = 0", "Subsubsection",
 CellChangeTimes->{{3.988440349006702*^9, 
  3.988440358135495*^9}},ExpressionUUID->"9d05c5d8-9ca6-4cf4-97e2-\
6979096faf15"],

Cell["\<\
(* N=2 PBC Hamiltonian at m=0, \[Epsilon]p=\[Epsilon]m=0.
   Hamn2RPBCm0 is the 4x4 symbolic matrix. Its eigenvalues en2RPBCm0
   are the bulk dispersion at k=0 and k=\[Pi] (arXiv:2606.24705, Eq.(4), at \
those
   specific quasi-momenta). The discriminant of the characteristic polynomial
   vanishes at the exceptional-point threshold \[Gamma]c = |t \[PlusMinus] \
t'|
   (arXiv:2606.24705, Eq.(6)). *)\
\>", "Input",
 CellLabel->
  "In[217]:=",ExpressionUUID->"1ed0defa-da08-4ba6-8974-499fdf0e9c7e"],

Cell["\<\
Hamn2RPBCm0 = hamTB[2, 1] /. {\[Epsilon]p -> 0, \[Epsilon]m -> 0, m -> 0};
MatrixForm[Hamn2RPBCm0];
{en2RPBCm0, vec2RPBCm0} = FullSimplify[
  Eigensystem[Hamn2RPBCm0],
  Assumptions -> {Im[t] == 0, Re[t] > 0, Im[tp] == 0, Re[tp] > 0,
                  Im[\[Gamma]] == 0, Re[\[Gamma]] > 0, Im[m] == 0, Re[m] > \
0}];\
\>", "Input",
 CellChangeTimes->{3.999335585966159*^9},
 CellLabel->
  "In[218]:=",ExpressionUUID->"0813b5e7-b3fd-4516-b451-7426b275b1ef"],

Cell["\<\
(* Display eigenvalues: en2RPBCm0 shows the four PBC eigenvalues
   E = \[PlusMinus]Sqrt[(t-t')^2 - \[Gamma]^2] and \[PlusMinus]Sqrt[(t+t')^2 \
- \[Gamma]^2],
   confirming arXiv:2606.24705, Eq.(4). *)\
\>", "Input",
 CellLabel->
  "In[221]:=",ExpressionUUID->"f1a99eb5-4e8a-461f-b9a0-0728376f0dd9"],

Cell[CellGroupData[{

Cell["en2RPBCm0", "Input",
 CellLabel->
  "In[222]:=",ExpressionUUID->"4f0e863f-1784-4e48-9977-cd29332b4237"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"-", 
    SqrtBox[
     RowBox[{
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{"t", "-", "tp"}], ")"}], "2"], "-", 
      SuperscriptBox["\[Gamma]", "2"]}]]}], ",", 
   SqrtBox[
    RowBox[{
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{"t", "-", "tp"}], ")"}], "2"], "-", 
     SuperscriptBox["\[Gamma]", "2"]}]], ",", 
   RowBox[{"-", 
    SqrtBox[
     RowBox[{
      RowBox[{"(", 
       RowBox[{"t", "+", "tp", "-", "\[Gamma]"}], ")"}], " ", 
      RowBox[{"(", 
       RowBox[{"t", "+", "tp", "+", "\[Gamma]"}], ")"}]}]]}], ",", 
   SqrtBox[
    RowBox[{
     RowBox[{"(", 
      RowBox[{"t", "+", "tp", "-", "\[Gamma]"}], ")"}], " ", 
     RowBox[{"(", 
      RowBox[{"t", "+", "tp", "+", "\[Gamma]"}], ")"}]}]]}], "}"}]], "Output",\

 CellChangeTimes->{3.999335590002795*^9, 3.999335637422709*^9, 
  3.999335673550955*^9, 3.999580259809712*^9, 3.9995802964046793`*^9},
 CellLabel->
  "Out[222]=",ExpressionUUID->"ea8501b6-7633-4a2d-98bf-7938bb146084"]
}, Open  ]],

Cell["\<\
(* Characteristic polynomial of Hamn2RPBCm0 - \[Lambda] I.
   Its discriminant in \[Lambda] identifies the EP threshold analytically. *)\
\
\>", "Input",
 CellLabel->
  "In[223]:=",ExpressionUUID->"26cb818d-6e8f-48d2-8d03-d84dfacef5e1"],

Cell[CellGroupData[{

Cell["\<\
eqsec2RPBCm0 = Det[Hamn2RPBCm0 - \[Lambda] IdentityMatrix[4]] // FullSimplify\
\
\>", "Input",
 CellLabel->
  "In[224]:=",ExpressionUUID->"89fce609-1e01-4300-98a9-7419c519e986"],

Cell[BoxData[
 RowBox[{
  SuperscriptBox["t", "4"], "+", 
  SuperscriptBox[
   RowBox[{"(", 
    RowBox[{
     RowBox[{"-", 
      SuperscriptBox["tp", "2"]}], "+", 
     SuperscriptBox["\[Gamma]", "2"], "+", 
     SuperscriptBox["\[Lambda]", "2"]}], ")"}], "2"], "-", 
  RowBox[{"2", " ", 
   SuperscriptBox["t", "2"], " ", 
   RowBox[{"(", 
    RowBox[{
     SuperscriptBox["tp", "2"], "+", 
     SuperscriptBox["\[Gamma]", "2"], "+", 
     SuperscriptBox["\[Lambda]", "2"]}], ")"}]}]}]], "Output",
 CellChangeTimes->{3.999335592465906*^9, 3.99933563742618*^9, 
  3.9993356735600767`*^9, 3.999580259828248*^9, 3.9995802964082823`*^9},
 CellLabel->
  "Out[224]=",ExpressionUUID->"378025be-4699-4dd3-b911-cb166545aea0"]
}, Open  ]],

Cell["\<\
(* Discriminant of the characteristic polynomial.
   At an EP two eigenvalues merge, so disc2RPBCm0 = 0.
   For N=2 PBC, m=0: disc = 4096 t^4 t'^4 \
(t-t'-\[Gamma])(t+t'-\[Gamma])(t-t'+\[Gamma])(t+t'+\[Gamma]).
   The EP locus is |t \[PlusMinus] t'| = \[Gamma], i.e. the four lines in the \
(t,t') plane. *)\
\>", "Input",
 CellLabel->
  "In[225]:=",ExpressionUUID->"6ea47254-6e35-4250-a646-a9e4bbfe76da"],

Cell[CellGroupData[{

Cell["disc2RPBCm0 = Discriminant[eqsec2RPBCm0, \[Lambda]] // FullSimplify", \
"Input",
 CellLabel->
  "In[226]:=",ExpressionUUID->"84128076-6819-4519-9527-76b34b75f0b2"],

Cell[BoxData[
 RowBox[{"4096", " ", 
  SuperscriptBox["t", "4"], " ", 
  SuperscriptBox["tp", "4"], " ", 
  RowBox[{"(", 
   RowBox[{"t", "-", "tp", "-", "\[Gamma]"}], ")"}], " ", 
  RowBox[{"(", 
   RowBox[{"t", "+", "tp", "-", "\[Gamma]"}], ")"}], " ", 
  RowBox[{"(", 
   RowBox[{"t", "-", "tp", "+", "\[Gamma]"}], ")"}], " ", 
  RowBox[{"(", 
   RowBox[{"t", "+", "tp", "+", "\[Gamma]"}], ")"}]}]], "Output",
 CellChangeTimes->{3.999335637437834*^9, 3.999335673568651*^9, 
  3.999580259846085*^9, 3.999580296424851*^9},
 CellLabel->
  "Out[226]=",ExpressionUUID->"2c8c687c-5dcc-48af-b3bb-5b09317fdb11"]
}, Open  ]],

Cell["(* Parametric function for numerical evaluation. *)", "Input",
 CellLabel->
  "In[227]:=",ExpressionUUID->"ffc2959b-a854-47b0-8f86-4e7e41ae381e"],

Cell["\<\
disc2RPBCm0f[tv_, tpv_, \[Gamma]v_] := disc2RPBCm0 /. {t -> tv, tp -> tpv, \
\[Gamma] -> \[Gamma]v}\
\>", "Input",
 CellLabel->
  "In[228]:=",ExpressionUUID->"d1f6eed2-5bd1-4732-b822-b2375e8fe4b1"],

Cell["\<\
(* ContourPlot of the EP locus disc2RPBCm0 = 0 in the (t/\[Gamma], \
t'/\[Gamma]) plane
   for \[Gamma]=1.  This is Fig. 3a of arXiv:2606.24705 \
(https://arxiv.org/abs/2606.24705).
   Controlled by showPlots: set False to skip and save file space. *)\
\>", "Input",
 CellLabel->
  "In[229]:=",ExpressionUUID->"0891fbd9-19e9-4feb-b83d-8c96c3870c07"],

Cell["\<\
If[showPlots,
  With[{\[Gamma] = 1},
    ContourPlot[disc2RPBCm0f[t, tp, 1] == 0, {t, -4, 4}, {tp, -4, 4},
      PlotPoints -> 100,
      FrameLabel -> {\"t/\[Gamma]\", \"t'/\[Gamma]\"}]],
  Null]\
\>", "Input",
 CellLabel->
  "In[230]:=",ExpressionUUID->"8cd69ab0-a641-49d6-b64e-7941d463a9f2"],

Cell["\<\
(* SVD-based EP detector on the (t/\[Gamma], t'/\[Gamma]) grid (\[Gamma]=1, \
m=0).
   svd2PBCm0 stores {t, t', logSVDmin} for a 435x435 grid from -5 to 5.
   This is the data for the density plot in Fig. 3b. *)\
\>", "Input",
 CellLabel->
  "In[231]:=",ExpressionUUID->"c5ead752-a88d-4c0c-a5f1-44d8efc0be87"],

Cell["\<\
svd2PBCm0 = With[{\[Delta] = 0.23/10},
  Flatten[ParallelTable[
    {t, tp, logSVDmin[Hamn2RPBCm0, t, tp, 1, 0]},
    {t, -5, 5, \[Delta]}, {tp, -5, 5, \[Delta]}], 1]];\
\>", "Input",
 CellLabel->
  "In[232]:=",ExpressionUUID->"9b156c22-0468-422e-87cf-4f8b2201c92c"],

Cell["\<\
(* Density plot of logSVDmin overlaid with the analytical EP contour.
   Controlled by showPlots. *)\
\>", "Input",
 CellLabel->
  "In[233]:=",ExpressionUUID->"8a0c7c4a-73bb-4904-b981-cb27a6ca224f"],

Cell["\<\
If[showPlots,
  Show[
    ListDensityPlot[svd2PBCm0,
      PlotRangePadding -> None,
      ColorFunction -> \"AvocadoColors\",
      FrameLabel -> {\"t/\[Gamma]\", \"t'/\[Gamma]\"},
      PlotLegends -> BarLegend[Automatic,
        LabelStyle -> {FontFamily -> \"Latin Modern Roman\", FontSize -> 24,
                        FontColor -> Black},
        LegendLabel -> Style[\"log10 \[Kappa](U)\",
          FontFamily -> \"Latin Modern Roman\", FontSize -> 26]],
      PlotRange -> {0, 2}],
    ContourPlot[disc2RPBCm0f[t, tp, 1] == 0, {t, -5, 5}, {tp, -5, 5},
      PlotPoints -> 100,
      ContourStyle -> {Black, AbsoluteThickness[0.8], Dashed}]],
  Null]\
\>", "Input",
 CellLabel->
  "In[234]:=",ExpressionUUID->"36a38c28-8167-4cd2-ba45-4e78ae567e92"],

Cell["(* MatrixForm display of H(N=2, PBC, m=0) for reference. *)", "Input",
 CellLabel->
  "In[235]:=",ExpressionUUID->"be60c75f-0d9f-472b-b82f-863686d97de4"],

Cell[CellGroupData[{

Cell["MatrixForm[Hamn2RPBCm0]", "Input",
 CellLabel->
  "In[236]:=",ExpressionUUID->"8b0894e2-0148-45f7-a9da-b9cf936524ff"],

Cell[BoxData[
 TagBox[
  RowBox[{"(", "\[NoBreak]", GridBox[{
     {
      RowBox[{"\[ImaginaryI]", " ", "\[Gamma]"}], 
      RowBox[{"-", "t"}], "0", 
      RowBox[{"-", "tp"}]},
     {
      RowBox[{"-", "t"}], 
      RowBox[{
       RowBox[{"-", "\[ImaginaryI]"}], " ", "\[Gamma]"}], 
      RowBox[{"-", "tp"}], "0"},
     {"0", 
      RowBox[{"-", "tp"}], 
      RowBox[{"\[ImaginaryI]", " ", "\[Gamma]"}], 
      RowBox[{"-", "t"}]},
     {
      RowBox[{"-", "tp"}], "0", 
      RowBox[{"-", "t"}], 
      RowBox[{
       RowBox[{"-", "\[ImaginaryI]"}], " ", "\[Gamma]"}]}
    },
    GridBoxAlignment->{"Columns" -> {{Center}}, "Rows" -> {{Baseline}}},
    GridBoxSpacings->{"Columns" -> {
        Offset[0.27999999999999997`], {
         Offset[0.7]}, 
        Offset[0.27999999999999997`]}, "Rows" -> {
        Offset[0.2], {
         Offset[0.4]}, 
        Offset[0.2]}}], "\[NoBreak]", ")"}],
  Function[BoxForm`e$, 
   MatrixForm[BoxForm`e$]]]], "Output",
 CellChangeTimes->{{3.9993356525629272`*^9, 3.9993356739743853`*^9}, 
   3.999580263253092*^9, 3.999580296837501*^9},
 CellLabel->
  "Out[236]//MatrixForm=",ExpressionUUID->"6162d2a1-097d-4f31-80cc-\
9f6dfd2d6edf"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["Case m \[NotEqual] 0", "Subsubsection",
 CellChangeTimes->{{3.988440349006702*^9, 3.988440358135495*^9}, {
  3.999580405709573*^9, 
  3.999580406539406*^9}},ExpressionUUID->"4291fd7d-730e-4960-b28d-\
d5525e95f697"],

Cell["\<\
(* N=2 PBC Hamiltonian with m\[NotEqual]0 (NNN on-site modulation).
   The NNN coupling m shifts eigenvalues and modifies the EP threshold.
   For N=2 PBC the eigenvalues become E = m \[PlusMinus] Sqrt[(t-t')^2 - \
\[Gamma]^2]
   and E = -m \[PlusMinus] Sqrt[(t+t')^2 - \[Gamma]^2]; the EP condition is
   unchanged (same \[Gamma]_c) but the spectrum is shifted by \[PlusMinus]m. \
*)\
\>", "Input",
 CellLabel->
  "In[239]:=",ExpressionUUID->"0bff471d-cd49-4d09-b0e9-313cb8f3edc4"],

Cell["\<\
Hamn2RPBCm = hamTB[2, 1] /. {\[Epsilon]p -> 0, \[Epsilon]m -> 0};
MatrixForm[Hamn2RPBCm];
(* The eigensystem is not evaluated symbolically: for m\[NotEqual]0 there is  \
  no compact closed-form solution known in general (arXiv:2606.24705).    EP \
detection proceeds via the discriminant and logSVDmin below. *)\
\>", "Input",
 CellChangeTimes->{{3.99933562107342*^9, 3.999335621074296*^9}},
 CellLabel->
  "In[240]:=",ExpressionUUID->"0813b5e7-b3fd-4516-b451-7426b275b2ef"],

Cell["Clear[disc2RPBC]", "Input",
 CellLabel->
  "In[243]:=",ExpressionUUID->"affe97c5-3adc-4b4d-b119-9517640b1c82"],

Cell["(* Characteristic polynomial for m\[NotEqual]0. *)", "Input",
 CellLabel->
  "In[244]:=",ExpressionUUID->"74ddf3c7-01d8-4d1c-8489-295d2467431d"],

Cell[CellGroupData[{

Cell["\<\
eqsec2RPBCm = Det[Hamn2RPBCm - \[Lambda] IdentityMatrix[4]] // FullSimplify\
\>", "Input",
 CellLabel->
  "In[245]:=",ExpressionUUID->"3940ebce-d0b5-4212-8203-bea5e06da561"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(", 
   RowBox[{
    RowBox[{"-", 
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{"t", "-", "tp"}], ")"}], "2"]}], "+", 
    SuperscriptBox["\[Gamma]", "2"], "+", 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{"m", "-", "\[Lambda]"}], ")"}], "2"]}], ")"}], " ", 
  RowBox[{"(", 
   RowBox[{
    RowBox[{"-", 
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{"t", "+", "tp"}], ")"}], "2"]}], "+", 
    SuperscriptBox["\[Gamma]", "2"], "+", 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{"m", "+", "\[Lambda]"}], ")"}], "2"]}], ")"}]}]], "Output",
 CellChangeTimes->{{3.999335653554401*^9, 3.999335674058086*^9}, 
   3.9995802632985697`*^9, 3.999580296873974*^9},
 CellLabel->
  "Out[245]=",ExpressionUUID->"a05e2c9f-f34e-4c2a-a923-ea4935594b8b"]
}, Open  ]],

Cell["\<\
(* Discriminant: roots at EP boundaries shifted by m^2 terms. *)\
\>", "Input",
 CellLabel->
  "In[246]:=",ExpressionUUID->"fec43cdf-a48e-432c-b9aa-3b1f051d9f6e"],

Cell[CellGroupData[{

Cell["disc2RPBCm = Discriminant[eqsec2RPBCm, \[Lambda]] // FullSimplify", \
"Input",
 CellLabel->
  "In[247]:=",ExpressionUUID->"2b370175-2c16-458b-a451-858ea8769282"],

Cell[BoxData[
 RowBox[{"4096", " ", 
  RowBox[{"(", 
   RowBox[{"t", "+", "tp", "-", "\[Gamma]"}], ")"}], " ", 
  RowBox[{"(", 
   RowBox[{"t", "+", "tp", "+", "\[Gamma]"}], ")"}], " ", 
  RowBox[{"(", 
   RowBox[{
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{"t", "-", "tp"}], ")"}], "2"], "-", 
    SuperscriptBox["\[Gamma]", "2"]}], ")"}], " ", 
  SuperscriptBox[
   RowBox[{"(", 
    RowBox[{
     RowBox[{
      RowBox[{"(", 
       RowBox[{"m", "-", "t"}], ")"}], " ", 
      RowBox[{"(", 
       RowBox[{"m", "+", "t"}], ")"}], " ", 
      RowBox[{"(", 
       RowBox[{"m", "-", "tp"}], ")"}], " ", 
      RowBox[{"(", 
       RowBox[{"m", "+", "tp"}], ")"}]}], "+", 
     RowBox[{
      SuperscriptBox["m", "2"], " ", 
      SuperscriptBox["\[Gamma]", "2"]}]}], ")"}], "2"]}]], "Output",
 CellChangeTimes->{{3.999335653591691*^9, 3.999335674062154*^9}, 
   3.9995802633344193`*^9, 3.999580296906041*^9},
 CellLabel->
  "Out[247]=",ExpressionUUID->"c94bf2ba-405f-488f-9d4e-99c9d50093ab"]
}, Open  ]],

Cell["\<\
disc2RPBCmf[tv_, tpv_, \[Gamma]v_, mv_] := disc2RPBCm /. {t -> tv, tp -> tpv, \
\[Gamma] -> \[Gamma]v, m -> mv}\
\>", "Input",
 CellLabel->
  "In[248]:=",ExpressionUUID->"cebdfbab-7a4d-48d1-bea5-dece3e54a921"],

Cell["\<\
(* ContourPlot for m\[NotEqual]0 case (commented out by default).
   Uncomment within the If block if needed. *)\
\>", "Input",
