Cell[CellGroupData[{

Cell["Case of Jordan decomposition at m = 0", "Subsubsection",
 CellChangeTimes->{{3.988440349006702*^9, 
  3.988440358135495*^9}},ExpressionUUID->"fc40feb8-44d6-4664-b2a5-\
4c2acb89d70d"],

Cell["\<\
(* Confirm EP for N=3 PBC via Jordan decomposition at (t, t', \[Gamma]) = (1, \
1, 1).
   At t = t' = \[Gamma] = 1 the mode at k=2\[Pi]/3 hits an EP since
   t^2 - tt' + t'^2 = 1 = \[Gamma]^2. *)\
\>", "Input",
 CellLabel->
  "In[317]:=",ExpressionUUID->"7e554eae-54b5-49d7-be7d-a064efb7e4ad"],

Cell["\<\
{Sjordan3, Jjordan3} = JordanDecomposition[
  N[Hamn3RPBCm0 /. {t -> 1, tp -> 1, \[Gamma] -> 1, \[Epsilon]p -> 0, \
\[Epsilon]m -> 0}]];
If[showPlots, MatrixForm[Jjordan3], Null]\
\>", "Input",
 CellLabel->
  "In[318]:=",ExpressionUUID->"c9e9960a-7fe5-444f-bdf5-88581f7c9190"]
}, Open  ]]
}, Open  ]],

