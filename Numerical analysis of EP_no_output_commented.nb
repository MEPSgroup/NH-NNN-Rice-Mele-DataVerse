Cell[CellGroupData[{
Cell["\<\
Investigation of the EPs for finite size Hamiltonians of the long-range \
Rice-Mele model: PBC vs OBC.\
\>", "Title",
 CellChangeTimes->{{3.988440188893673*^9, 
  3.9884402022462873`*^9}},ExpressionUUID->"712c9696-11c1-442b-b40b-\
3361f4bac19f"],

Cell["\<\
Dario Bercioux
Summer term 2026\
\>", "Subtitle",
 CellChangeTimes->{{3.988440206787942*^9, 
  3.988440222732465*^9}},ExpressionUUID->"0cfce0a5-831b-42a3-8b22-\
62ef1b8bf110"],

Cell["\<\
(* ============================================================
   SECTION 1: INITIALISATION
   ============================================================

   SAFETY GUARD: The Exit[] command below prevents accidental evaluation of
   the entire notebook via Kernel -> Evaluate Notebook. Comment it out or \
skip
