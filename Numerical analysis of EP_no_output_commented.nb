Cell["\<\
(*
If[showPlots,
  With[{\[Gamma] = 1, m = 1},
    ContourPlot[disc2RPBCmf[t, tp, \[Gamma], m] == 0, {t, -4, 4}, {tp, -4, \
4},
      PlotPoints -> 100,
      FrameLabel -> {\"t/\[Gamma]\", \"t'/\[Gamma]\"}]],
  Null]
*)\
\>", "Input",
 CellLabel->
  "In[250]:=",ExpressionUUID->"8e10d800-8286-4f48-b45f-2864b8b7b1b6"],

Cell["(* SVD grid for m=1, \[Gamma]=1. *)", "Input",
 CellLabel->
  "In[251]:=",ExpressionUUID->"f98cecf4-202c-4ac7-9022-fdbe794205fd"],

Cell["\<\
svd2PBCm = With[{\[Delta] = 0.023},
  Flatten[ParallelTable[
    {t, tp, logSVDmin[Hamn2RPBCm, t, tp, 1, 1]},
    {t, -5, 5, \[Delta]}, {tp, -5, 5, \[Delta]}], 1]];\
\>", "Input",
 CellLabel->
  "In[252]:=",ExpressionUUID->"ae552c29-b809-40ac-aecf-eac4177b7921"],

Cell["\<\
(* Density plot overlaid with analytical EP contour (m=1, \[Gamma]=1).
   Controlled by showPlots. *)\
