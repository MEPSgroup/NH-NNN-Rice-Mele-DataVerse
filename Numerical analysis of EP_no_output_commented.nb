Cell["Open boundary condition case", "Subsection",
 CellChangeTimes->{{3.98844029114736*^9, 
  3.9884403025389853`*^9}},ExpressionUUID->"dc6bfe15-8932-47ab-9b8b-\
d642b095348d"],

Cell[CellGroupData[{

Cell["Case m = 0", "Subsubsection",
 CellChangeTimes->{{3.988440349006702*^9, 
  3.988440358135495*^9}},ExpressionUUID->"6ba9151b-97ee-4c04-8a67-\
b2e938197fca"],

Cell["\<\
(* N=3 OBC at m=0. Boundary conditions remove the PBC wrap-around hoppings.
   The OBC eigenvalues differ from PBC and surface states can appear. *)\
\>", "Input",
